---
// src/components/articles/TableOfContents.astro
//
// Renders a Heading[] (from lib/supabaseArticles.ts's extractHeadings())
// as a table of contents. Two presentations, same data:
//   - Desktop: sticky sidebar card
//   - Mobile: collapsible <details> dropdown above the article body
// Both are plain anchor links (#slug) — no JS, no scroll-spy. Caller
// decides whether to render this at all (see [slug].astro: only when
// there are enough headings to be worth it).
import type { Heading } from '../../lib/supabaseArticles';

interface Props {
  headings: Heading[];
}
const { headings } = Astro.props as Props;

// Article headings in the CMS sometimes carry a decorative leading emoji
// or a trailing run of ⭐ "rating" glyphs. A table of contents is a
// navigation aid — strip that noise so it reads cleanly.
function tidy(text: string): string {
  return text
    .replace(/[\u{1F000}-\u{1FAFF}\u{2600}-\u{27BF}\u{2B00}-\u{2BFF}\u{2190}-\u{21FF}\u{FE0F}\u{200D}]/gu, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
}
---

<!-- Desktop: sticky sidebar -->
<nav class="toc toc--desktop" aria-label="Table of contents">
  <div class="toc__title">Table of Contents</div>
  <ul class="toc__list">
    {headings.map((h) => (
      <li class={`toc__item toc__item--level-${h.level}`}>
        <a href={`#${h.slug}`}>{tidy(h.text)}</a>
      </li>
    ))}
  </ul>
</nav>

<!-- Mobile: collapsible dropdown -->
<details class="toc toc--mobile">
  <summary class="toc__mobile-summary">
    <span>Table of Contents</span>
    <span class="toc__chevron" aria-hidden="true">↓</span>
  </summary>
  <ul class="toc__list">
    {headings.map((h) => (
      <li class={`toc__item toc__item--level-${h.level}`}>
        <a href={`#${h.slug}`}>{tidy(h.text)}</a>
      </li>
    ))}
  </ul>
</details>

<style>
  .toc__title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-secondary, #f59e0b);
    margin-bottom: 12px;
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__item {
    margin-bottom: 2px;
  }
  .toc__item--level-3 {
    padding-left: 14px;
  }

  .toc__item a {
    display: block;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 13px;
    line-height: 1.4;
    color: #374151;
    text-decoration: none;
  }
  .toc__item--level-2 a {
    font-weight: 600;
    color: var(--brand-primary-dark, #0c4a6e);
  }
  .toc__item a:hover {
    background: rgba(2, 132, 199, 0.06);
    color: var(--brand-primary, #0284c7);
  }

  /* Desktop sidebar */
  .toc--desktop {
    display: none;
  }
  @media (min-width: 900px) {
    .toc--desktop {
      display: block;
      position: sticky;
      top: 5rem;
      align-self: start;
      background: #fff;
      border: 1.5px solid #e5e7eb;
      border-radius: 12px;
      padding: 20px;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
  }

  /* Mobile dropdown */
  .toc--mobile {
    display: block;
    background: #fff;
    border: 1.5px solid #e5e7eb;
    border-radius: 12px;
    padding: 4px 20px;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 900px) {
    .toc--mobile {
      display: none;
    }
  }
  .toc__mobile-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--brand-primary-dark, #0c4a6e);
    list-style: none;
  }
  .toc__mobile-summary::-webkit-details-marker {
    display: none;
  }
  .toc__chevron {
    font-size: 16px;
    color: var(--brand-secondary, #f59e0b);
    transition: transform 0.2s ease;
  }
  .toc--mobile[open] .toc__chevron {
    transform: rotate(180deg);
  }
  .toc--mobile .toc__list {
    padding-bottom: 12px;
  }

  @media print {
    .toc--desktop,
    .toc--mobile {
      display: none !important;
    }
  }
</style>