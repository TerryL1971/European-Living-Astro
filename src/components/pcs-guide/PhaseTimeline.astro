---
// src/components/pcs-guide/PhaseTimeline.astro
//
// Renders PHASES from data/pcsGuidePhases.ts as accordion sections.
// Uses native <details>/<summary> instead of React state — no client
// JS needed for expand/collapse, keyboard-accessible by default.
import { PHASES, type Resource } from '../../data/pcsGuidePhases';

const RESOURCE_BADGE: Record<Resource['type'], string> = {
  official: 'Official',
  download: '⬇ Download',
  guide: 'EL Guide',
};
---

<div class="phase-timeline">
  {PHASES.map((phase, i) => (
    <details class="phase" open={i === 0}>
      <summary class="phase__header">
        <span class="phase__icon">{phase.icon}</span>
        <span class="phase__header-text">
          <span class="phase__timing">{phase.timing}</span>
          <span class="phase__title">{phase.title}</span>
          <span class="phase__subtitle">{phase.subtitle}</span>
        </span>
        <span class="phase__chevron" aria-hidden="true">↓</span>
      </summary>

      <div class="phase__body">
        {phase.warning && (
          <div class="phase__callout phase__callout--warning">
            <strong>⚠ Important:</strong> {phase.warning}
          </div>
        )}

        <div class="phase__section-label">Action Steps</div>
        <ol class="phase__steps">
          {phase.steps.map((step, si) => (
            <li>
              <span class="phase__step-number">{si + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>

        {phase.tip && (
          <div class="phase__callout phase__callout--tip">
            <strong>💡 Tip:</strong> {phase.tip}
          </div>
        )}

        {phase.resources.length > 0 && (
          <>
            <div class="phase__section-label">Resources &amp; Downloads</div>
            <div class="phase__resources">
              {phase.resources.map((r) => {
                const isExternal = r.url.startsWith('http');
                return (
                  <a
                    href={r.url}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    class="phase__resource"
                  >
                    <span class="phase__resource-text">
                      <span class="phase__resource-label">{r.label}</span>
                      <span class="phase__resource-desc">{r.description}</span>
                    </span>
                    <span class={`phase__resource-badge phase__resource-badge--${r.type}`}>
                      {RESOURCE_BADGE[r.type]}
                    </span>
                  </a>
                );
              })}
            </div>
          </>
        )}
      </div>
    </details>
  ))}
</div>

<style>
  .phase-timeline {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 780px;
    margin: 0 auto;
  }

  .phase {
    border: 1.5px solid var(--border, #e5e7eb);
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }

  .phase[open] {
    box-shadow: 0 4px 24px rgba(27, 58, 92, 0.12);
  }

  .phase__header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
  }
  .phase__header::-webkit-details-marker {
    display: none;
  }

  .phase[open] .phase__header {
    background: var(--brand-primary-dark, #0c4a6e);
    color: #fff;
  }

  .phase__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    background: rgba(2, 132, 199, 0.08);
  }
  .phase[open] .phase__icon {
    background: rgba(255, 255, 255, 0.15);
  }

  .phase__header-text {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .phase__timing {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-secondary, #f59e0b);
  }
  .phase[open] .phase__timing {
    color: #fff;
    opacity: 0.75;
  }

  .phase__title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    margin-top: 2px;
  }

  .phase__subtitle {
    font-size: 13px;
    color: #6b7280;
    margin-top: 2px;
  }
  .phase[open] .phase__subtitle {
    display: none;
  }

  .phase__chevron {
    flex-shrink: 0;
    font-size: 20px;
    opacity: 0.6;
    transition: transform 0.2s ease;
  }
  .phase[open] .phase__chevron {
    transform: rotate(180deg);
  }

  .phase__body {
    padding: 4px 24px 24px;
    border-top: 1.5px solid var(--brand-primary-dark, #0c4a6e);
  }

  .phase__callout {
    margin: 16px 0 0;
    padding: 12px 16px;
    border-radius: 0 8px 8px 0;
    font-size: 13px;
    line-height: 1.5;
  }
  .phase__callout--warning {
    background: #fef3c7;
    border-left: 4px solid #d97706;
    color: #92400e;
  }
  .phase__callout--tip {
    background: rgba(2, 132, 199, 0.05);
    border-left: 4px solid var(--brand-primary, #0284c7);
    color: #374151;
  }

  .phase__section-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-primary, #0284c7);
    margin: 20px 0 12px;
  }

  .phase__steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .phase__steps li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 10px;
    font-size: 14px;
    line-height: 1.55;
    color: #374151;
  }
  .phase__step-number {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(2, 132, 199, 0.1);
    color: var(--brand-primary, #0284c7);
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .phase__resources {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .phase__resource {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s ease;
  }
  .phase__resource:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .phase__resource-text {
    flex: 1;
    min-width: 0;
  }
  .phase__resource-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-primary-dark, #0c4a6e);
    margin-bottom: 3px;
  }
  .phase__resource-desc {
    display: block;
    font-size: 12px;
    color: #6b7280;
    line-height: 1.4;
  }

  .phase__resource-badge {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fff;
  }
  .phase__resource-badge--official {
    background: var(--brand-primary-dark, #0c4a6e);
  }
  .phase__resource-badge--download {
    background: var(--brand-secondary, #f59e0b);
  }
  .phase__resource-badge--guide {
    background: #d97706;
  }
</style>