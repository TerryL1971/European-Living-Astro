---
// src/components/pcs-guide/QuickJumpNav.astro
//
// Sticky in-page nav. Plain anchor links + CSS scroll-behavior instead
// of the original's window.scrollTo() click handler — no JS needed.
// scroll-margin-top on each target section (set where each section is
// rendered in pcs-guide.astro) handles the sticky-header offset that
// the original computed manually in JS.

const LINKS = [
  { label: '📋 PCS Phases', id: 'phases' },
  { label: '📚 In-Depth Guides', id: 'guides' },
  { label: '📞 Key Contacts', id: 'contacts' },
  { label: '❓ FAQs', id: 'faq' },
];
---

<nav class="quick-jump" aria-label="Jump to section">
  <div class="quick-jump__inner">
    {LINKS.map(({ label, id }) => (
      <a href={`#${id}`} class="quick-jump__link">{label}</a>
    ))}
  </div>
</nav>

<style>
  .quick-jump {
    position: sticky;
    top: 64px;
    z-index: 40;
    background: #fff;
    border-bottom: 1px solid #e5e7eb;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .quick-jump__inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .quick-jump__inner::-webkit-scrollbar {
    display: none;
  }

  .quick-jump__link {
    padding: 14px 16px;
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-primary-dark, #0c4a6e);
    text-decoration: none;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .quick-jump__link:hover {
    border-bottom-color: var(--brand-secondary, #f59e0b);
  }
</style>