---
// src/components/page/HeroSection.astro
//
// Ported from HeroSection.tsx as a fully STATIC component — no React
// island needed at all. Every interaction in the original was either:
//   - scrollToDestinations/scrollToEmailSignup: smooth-scroll to an
//     anchor, which plain <a href="#id"> already does since
//     `scroll-behavior: smooth` is set globally in global.css
//   - the Facebook link: already a plain external <a>
//   - the PCS Guide banner Link and "Read Terry's story" navigate():
//     both just internal navigation, which is a plain <a href="..."> in
//     Astro's multi-page model (same reasoning as Header.tsx's port)
// Zero client-side JS is a genuine win here, not just a simplification —
// this is above-the-fold content, so shipping no JS for it helps time-
// to-interactive on every single page load.
//
// Stats (day trips / businesses / phrases) are now pulled live from
// Supabase via lib/siteStats.ts instead of hardcoded — see that file
// for the counting/rounding logic and why it's build-time-cached.

import { getSiteStats } from '../../lib/siteStats';

// Self-hosted + optimised (was a 544 KB / 2535px JPEG on Supabase with a
// 1-hour cache — measured as the LCP element at ~6.3s on mobile). Now a
// 1800px WebP (~90 KB) served same-origin with a long cache header (see
// vercel.json). Keep the .jpg sibling as the <picture> fallback.
// Filename bumped to -2 on the 2026-08-31 regrade: images carry a
// 30-day browser cache (vercel.json), so returning visitors would keep
// seeing the old "milky" file for weeks. A new URL forces a clean fetch.
const heroWebp = '/hero-bg-2.webp';
const heroJpg = '/hero-bg-2.jpg';
const stats = await getSiteStats();
---

<section id="home" aria-label="Hero" class="hero-section">
  <!--
    A real <img>, not a CSS background-image — measured directly via
    Lighthouse against production: this is the LCP element, and a CSS
    background-image isn't discoverable by the browser's preload
    scanner until AFTER the CSS has loaded (the CSSOM has to be built
    first to even know the background exists), unlike an <img src>
    which gets found immediately while parsing the raw HTML. That
    "resource load delay" was the single largest chunk of LCP time
    (~1.3s of it), bigger than the image's own download time.
    fetchpriority="high" (and no loading="lazy") tells the browser to
    fetch it as early and eagerly as possible, on top of that.
  -->
  <picture>
    <source srcset={heroWebp} type="image/webp" />
    <img
      src={heroJpg}
      alt=""
      class="hero-section__bg-image"
      fetchpriority="high"
      width="1800"
      height="512"
    />
  </picture>
  <div class="hero-section__scrim" aria-hidden="true"></div>

  <div class="hero-section__content">
    <h1 class="hero-section__title">
      Discover Europe <span class="hero-section__title-accent">Beyond</span> the Base
    </h1>

    <p class="hero-section__subtitle">
      The independent guide for American military families in Germany — day trips, the PCS process, and
      English-speaking services, all in one place.
    </p>

    <div class="hero-section__stats">
      <div class="hero-section__stat">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hero-section__stat-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        <span>{stats.dayTripsLabel}</span>
      </div>
      <div class="hero-section__stat">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hero-section__stat-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>{stats.destinationsLabel}</span>
      </div>
      <div class="hero-section__stat">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hero-section__stat-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 10-4-4" /></svg>
        <span>{stats.businessesLabel}</span>
      </div>
      <div class="hero-section__stat">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hero-section__stat-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v14M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" /></svg>
        <span>{stats.phrasesLabel}</span>
      </div>
    </div>

    <p class="hero-section__trust">
      Built by a U.S. Air Force veteran who's lived in Germany since 2016.
    </p>

    <div class="hero-section__ctas">
      <a href="#destinations" class="hero-section__cta hero-section__cta--primary">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-section__cta-icon"><path d="M9 18l-6 3V6l6-3 6 3 6-3v10.5"/><path d="M9 3v15M15 6v6"/><circle cx="18" cy="18" r="3"/><path d="M18 15v-1M22 22l-1.9-1.9"/></svg>
        Explore Destinations
      </a>

      <a href="/pcs-guide" class="hero-section__cta hero-section__cta--gold">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-section__cta-icon"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
        PCS to Germany Guide
      </a>
    </div>

    <p class="hero-section__community">
      <a href="https://www.facebook.com/EuropeanLivingOfficial" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="hero-section__fb-icon" aria-hidden="true">
          <path d="M24 12.073C24 5.404 18.627 0 12 0S0 5.404 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" />
        </svg>
        Follow on Facebook
      </a>
    </p>

    <!--
      PCS Guide banner — understated on purpose, shouldn't compete with
      the primary CTAs above but should be unmissable for someone about
      to PCS. Matches Header.tsx's "PCS Guide" nav treatment.
    -->
    <div class="hero-section__pcs-banner-wrap">
      <a href="/pcs-guide" class="hero-section__pcs-banner">
        <span class="hero-section__pcs-icon">✈️</span>
        <div class="hero-section__pcs-text">
          <div class="hero-section__pcs-title">PCSing to Germany?</div>
          <div class="hero-section__pcs-subtitle">Our step-by-step guide — available at USO lounges nationwide</div>
        </div>
        <span class="hero-section__pcs-badge">USO</span>
        <span class="hero-section__pcs-arrow">→</span>
      </a>
    </div>

    <p class="hero-section__secondary-cta">
      <a href="/about">Read Terry's story →</a>
    </p>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #000; /* fallback while the image above loads */
  }
  .hero-section > picture {
    display: contents;
  }
  .hero-section__bg-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }
  /*
    Scrim over the hero photo: an even wash plus a soft radial pool
    centred on the headline, so the white copy holds contrast over the
    sunlit side of the image without the picture going murky. The photo
    itself is graded and textured at the file level (see public/hero-bg.*),
    so no CSS grain layer is needed.
  */
  .hero-section__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 82% 72% at 50% 42%, rgba(3, 18, 30, 0.62) 0%, rgba(3, 18, 30, 0.34) 55%, rgba(3, 18, 30, 0.08) 100%),
      linear-gradient(180deg, rgba(3, 18, 30, 0.22) 0%, rgba(3, 18, 30, 0.1) 42%, rgba(3, 18, 30, 0.42) 100%);
  }
  .hero-section__content {
    position: relative;
    z-index: 10;
    padding: 0 1.5rem;
    text-align: center;
    color: white;
    max-width: 64rem;
  }
  .hero-section__title {
    font-size: 2.35rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 2px rgba(3, 18, 30, 0.55), 0 2px 22px rgba(3, 18, 30, 0.6);
  }
  .hero-section__title-accent {
    color: var(--brand-secondary-light, #fbbf24);
    font-style: italic;
  }
  @media (min-width: 768px) {
    .hero-section__title {
      font-size: 3.5rem;
    }
  }
  @media (min-width: 1024px) {
    .hero-section__title {
      font-size: 4rem;
    }
  }
  .hero-section__subtitle {
    max-width: 44rem;
    margin: 0 auto 2rem;
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    color: #fff;
    text-shadow: 0 1px 3px rgba(3, 18, 30, 0.7), 0 2px 16px rgba(3, 18, 30, 0.55);
  }
  @media (min-width: 768px) {
    .hero-section__subtitle {
      font-size: 1.25rem;
    }
  }
  .hero-section__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    font-size: 0.9375rem;
    text-shadow: 0 1px 3px rgba(3, 18, 30, 0.75), 0 1px 10px rgba(3, 18, 30, 0.5);
  }
  .hero-section__stat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .hero-section__stat-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--brand-gold, #f5c04a);
    flex-shrink: 0;
  }
  .hero-section__trust {
    max-width: 42rem;
    margin: 0 auto 2.25rem;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 3px rgba(3, 18, 30, 0.75), 0 1px 10px rgba(3, 18, 30, 0.5);
  }
  .hero-section__ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .hero-section__ctas {
      flex-direction: row;
    }
  }
  .hero-section__cta {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.125rem;
    padding: 1rem 2rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  }
  @media (min-width: 640px) {
    .hero-section__cta {
      width: auto;
    }
  }
  .hero-section__cta:hover {
    transform: scale(1.05);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25);
  }
  .hero-section__cta--primary {
    background: var(--brand-primary, #1e40af);
    color: white;
  }
  .hero-section__cta--primary:hover {
    background: var(--brand-dark, #153a84);
  }
  .hero-section__cta--gold {
    background: var(--brand-gold, #f5c04a);
    color: #131312;
  }
  .hero-section__cta--gold:hover {
    background: var(--brand-button);
  }
  .hero-section__cta--facebook {
    background: #1877f2;
    color: white;
  }
  .hero-section__cta--facebook:hover {
    background: #0f5bbf;
  }
  .hero-section__fb-icon {
    width: 1.25rem;
    height: 1.25rem;
  }
  .hero-section__cta-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }
  .hero-section__community {
    margin: 1.25rem auto 0;
    font-size: 0.9375rem;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
  }
  .hero-section__community a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }
  .hero-section__community a:hover {
    color: var(--brand-gold, #f5c04a);
  }
  .hero-section__community .hero-section__fb-icon {
    width: 1rem;
    height: 1rem;
  }
  .hero-section__pcs-banner-wrap {
    margin-top: 2rem;
  }
  .hero-section__pcs-banner {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    border-radius: 1rem;
    text-decoration: none;
    transition: transform 0.2s ease;
    background: rgba(27, 58, 92, 0.75);
    border: 1px solid rgba(157, 165, 134, 0.5);
    backdrop-filter: blur(8px);
  }
  .hero-section__pcs-banner:hover {
    transform: scale(1.05);
  }
  .hero-section__pcs-icon {
    font-size: 1.25rem;
  }
  .hero-section__pcs-text {
    text-align: left;
  }
  .hero-section__pcs-title {
    color: white;
    font-weight: 700;
    font-size: 0.875rem;
    line-height: 1.2;
  }
  .hero-section__pcs-subtitle {
    color: #c8d4b4;
    font-size: 0.75rem;
    line-height: 1.2;
  }
  .hero-section__pcs-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    background-color: #9da586;
    color: white;
    flex-shrink: 0;
  }
  .hero-section__pcs-arrow {
    color: #9da586;
    font-weight: 700;
    font-size: 0.875rem;
  }
  .hero-section__secondary-cta {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    opacity: 0.8;
  }
  .hero-section__secondary-cta a {
    color: white;
    text-decoration: underline;
    transition: color 0.2s ease;
  }
  .hero-section__secondary-cta a:hover {
    color: var(--brand-gold, #f5c04a);
  }
</style>