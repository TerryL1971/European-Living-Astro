---
// Ported from Footer.tsx. Fully static — every link is a plain <a>,
// and the one interactive piece (Cookie Settings) is handled by a
// small inline <script> below rather than a React island, since it's
// a single click handler with no state.
//
// Stats (businesses/years/bases) now pulled live from Supabase via
// lib/siteStats.ts instead of hardcoded — this also fixes a real
// inconsistency that existed on the live site, where the Footer said
// "150+ Businesses" while the Hero said "200+ Businesses". Both now
// read from the same source, so they can never disagree again.
import { SITE } from '../../lib/seo/siteConfig';
import { getSiteStats } from '../../lib/siteStats';

const stats = await getSiteStats();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <!-- About -->
      <div>
        <h3 class="site-footer__brand">European Living</h3>
        <p class="site-footer__about-text">
          Your guide to living, working, and exploring Germany and Europe as a U.S. military member or expat.
        </p>
        <a
          href={SITE.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="site-footer__social-link"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="site-footer__icon" aria-hidden="true">
            <path d="M24 12.073C24 5.404 18.627 0 12 0S0 5.404 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
          </svg>
          Follow on Facebook
        </a>
        <a
          href="https://www.instagram.com/european.living.live/"
          target="_blank"
          rel="noopener noreferrer"
          class="site-footer__social-link"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="site-footer__icon" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Follow on Instagram
        </a>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="site-footer__heading">Quick Links</h4>
        <ul class="site-footer__list">
          <li><a href="/">Home</a></li>
          <li><a href="/pcs-guide">PCS Guide to Germany</a></li>
          <li><a href="/services-directory">Services Directory</a></li>
          <li><a href="/day-trips">Day Trips</a></li>
          <li><a href="/family-adventures">Family Adventures</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="site-footer__heading">Resources</h4>
        <ul class="site-footer__list">
          <li><a href="/submit-business">Submit Your Business</a></li>
          <li>
            <a href="https://www.usedcarguys.net" target="_blank" rel="noopener noreferrer">
              Used Car Guys GmbH
            </a>
          </li>
          <li>
            <a href="https://www.americanautonation.com" target="_blank" rel="noopener noreferrer">
              American Auto Nation Insurance
            </a>
          </li>
          <li>
            <a href="https://expattax.de/" target="_blank" rel="noopener noreferrer">
              German Tax Advice for English Speaking Expats
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="site-footer__heading">Legal</h4>
        <ul class="site-footer__list">
          <li><a href="/impressum">Impressum</a></li>
          <li><a href="/terms-of-service">Terms of Service</a></li>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li>
            <button type="button" id="footer-cookie-settings" class="site-footer__cookie-btn">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="site-footer__icon" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <circle cx="9" cy="9" r="0.6" fill="currentColor" />
                <circle cx="14" cy="8.5" r="0.6" fill="currentColor" />
                <circle cx="15" cy="13" r="0.6" fill="currentColor" />
                <circle cx="10" cy="14" r="0.6" fill="currentColor" />
              </svg>
              Cookie Settings
            </button>
          </li>
        </ul>
      </div>
    </div>

    <!-- Stats strip -->
    <div class="site-footer__stats">
      <div>
        <div class="site-footer__stat-figure">📍 {stats.businessesLabel}</div>
        <div class="site-footer__stat-label">Verified English-friendly services</div>
      </div>
      <div>
        <div class="site-footer__stat-figure">🎖️ {stats.yearsLabel}</div>
        <div class="site-footer__stat-label">Serving the military community</div>
      </div>
      <div>
        <div class="site-footer__stat-figure">🗺️ {stats.basesLabel}</div>
        <div class="site-footer__stat-label">Major US installations covered</div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        © {new Date().getFullYear()} {SITE.name}. All rights reserved. Serving the American military community in Germany.
      </p>
      <div class="site-footer__bottom-links">
        <a href="/impressum">Impressum</a>
        <span>·</span>
        <a href="/privacy-policy">Privacy</a>
        <span>·</span>
        <a href="/terms-of-service">Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #111827;
    color: #d1d5db;
    margin-top: auto;
  }
  .site-footer__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .site-footer__brand {
    color: white;
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }
  .site-footer__about-text {
    font-size: 0.875rem;
    color: #9ca3af;
  }
  .site-footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: #9ca3af;
    text-decoration: none;
  }
  .site-footer__social-link:hover {
    color: white;
  }
  .site-footer__icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .site-footer__heading {
    color: white;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .site-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
  }
  .site-footer__list a {
    color: inherit;
    text-decoration: none;
  }
  .site-footer__list a:hover {
    color: white;
  }
  .site-footer__cookie-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    color: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    padding: 0;
    text-align: left;
  }
  .site-footer__cookie-btn:hover {
    color: white;
  }
  .site-footer__stats {
    border-top: 1px solid var(--brand-primary);
    border-top-color: color-mix(in srgb, var(--brand-primary) 30%, transparent);
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .site-footer__stats {
      grid-template-columns: repeat(3, 1fr);
      text-align: left;
    }
  }
  .site-footer__stat-figure {
    color: var(--brand-gold);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .site-footer__stat-label {
    font-size: 0.875rem;
    color: var(--brand-bg-alt);
  }
  .site-footer__bottom {
    border-top: 1px solid #1f2937;
    padding-top: 2rem;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  .site-footer__copyright {
    font-size: 0.875rem;
    color: #9ca3af;
  }
  .site-footer__bottom-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    color: #6b7280;
  }
  .site-footer__bottom-links a {
    color: inherit;
    text-decoration: none;
  }
  .site-footer__bottom-links a:hover {
    color: #d1d5db;
  }
</style>

<script>
  // Wrapped in astro:page-load — see BaseLayout.astro's <ClientRouter />
  // comment. The footer (like the rest of <body>) gets swapped out on
  // every transition, taking this button's listener with it, unless
  // re-attached on every page-load.
  document.addEventListener('astro:page-load', () => {
    document.getElementById('footer-cookie-settings')?.addEventListener('click', () => {
      localStorage.removeItem('cookieConsent');
      window.dispatchEvent(new Event('openCookieSettings'));
    });
  });
</script>