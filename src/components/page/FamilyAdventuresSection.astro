---
// src/components/page/FamilyAdventuresSection.astro
// Homepage teaser for /family-adventures. Ported from
// FamilyAdventuresSection.tsx — the original only used React state for
// onClick-navigate(), so this needs no client JS at all; every card and
// the CTA are just links.
//
// One card surface, one icon set. Each icon carries a muted accent
// colour (stroke + a faint chip tint) so the grid has some life without
// the old "different fill + border + heading colour per card" look.

const CATEGORIES = [
  {
    title: 'Theme Parks & Attractions',
    description: 'LEGOLAND, Europa-Park, Phantasialand and more — perfect for all ages.',
    tint: '#b8802f',
    icon: '<path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2M13 17v2M13 11v2"/>',
  },
  {
    title: 'Castles & History',
    description: 'Bring history to life at fairy-tale castles kids will never forget.',
    tint: '#7c6bb0',
    icon: '<path d="M22 20v-9H2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2Z"/><path d="M18 11V4H6v7"/><path d="M15 22v-4a3 3 0 0 0-6 0v4"/><path d="M22 11V9M2 11V9M6 4V2M18 4V2"/>',
  },
  {
    title: 'Parks & Playgrounds',
    description: 'Beautiful parks, nature trails, and playgrounds near every base.',
    tint: '#5e9350',
    icon: '<path d="M10 10v.2A3 3 0 0 1 8.9 16H5a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0Z"/><path d="M7 16v6M13 19v3M12 19h8.3a1 1 0 0 0 .7-1.7L18 14h.3a1 1 0 0 0 .7-1.7L16 9h.2a1 1 0 0 0 .8-1.7L13 3l-1.4 1.5"/>',
  },
  {
    title: 'Schools & Education',
    description: 'International schools, homeschool resources, and tutoring near base.',
    tint: '#4f7cb0',
    icon: '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>',
  },
  {
    title: 'Sports & Activities',
    description: 'Soccer, swimming, gymnastics, martial arts and more for every age.',
    tint: '#b05e6d',
    icon: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  },
  {
    title: 'Family-Friendly Dining',
    description: 'Kid-friendly restaurants that welcome families with English menus.',
    tint: '#bd6a4e',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2M7 2v20M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
];
---
<section class="fam">
  <div class="fam__inner">
    <div class="fam__head">
      <p class="fam__eyebrow">For Families</p>
      <h2>Family Adventures in Europe</h2>
      <p class="fam__lede">
        Europe is an incredible playground for kids. Find family-friendly destinations,
        activities, schools, and services — all tailored for military families near US bases.
      </p>
    </div>

    <div class="fam__grid">
      {CATEGORIES.map((cat) => (
        <a href="/family-adventures" class="fam-card">
          <div class="fam-card__head">
            <span class="fam-card__icon" aria-hidden="true" style={`--tint:${cat.tint}`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={cat.icon} />
            </span>
            <h3>{cat.title}</h3>
          </div>
          <p>{cat.description}</p>
        </a>
      ))}
    </div>

    <div class="fam__cta">
      <a href="/family-adventures" class="fam__btn">Explore all family resources</a>
      <p>Base-specific guides for Germany · Travel highlights for UK, Italy &amp; Spain</p>
    </div>
  </div>
</section>

<style>
  .fam {
    background: var(--brand-bg-card);
    padding: 4.5rem 0;
  }
  .fam__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .fam__head {
    text-align: center;
    margin-bottom: 2.75rem;
  }
  .fam__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand-primary);
    margin: 0 0 0.75rem;
  }
  .fam__head h2 {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--brand-dark);
    margin: 0 0 0.85rem;
  }
  .fam__lede {
    color: var(--brand-text-muted);
    max-width: 40rem;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .fam__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 560px) {
    .fam__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .fam__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .fam-card {
    display: block;
    padding: 1.5rem;
    background: var(--brand-bg-card);
    border: 1px solid var(--brand-border);
    border-radius: 0.9rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .fam-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -16px rgba(3, 20, 32, 0.35);
    border-color: var(--brand-primary);
  }
  .fam-card__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }
  .fam-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--tint, var(--brand-primary)) 13%, transparent);
    color: var(--tint, var(--brand-primary));
    flex-shrink: 0;
  }
  .fam-card__icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }
  .fam-card h3 {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--brand-dark);
    margin: 0;
    line-height: 1.25;
  }
  .fam-card p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--brand-text-muted);
    margin: 0;
  }
  .fam__cta {
    text-align: center;
  }
  .fam__btn {
    display: inline-block;
    padding: 0.9rem 1.9rem;
    background: var(--brand-primary);
    color: #fff;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .fam__btn:hover {
    background: var(--brand-primary-dark);
    transform: translateY(-1px);
  }
  .fam__cta p {
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
    color: var(--brand-text-muted);
  }
</style>
