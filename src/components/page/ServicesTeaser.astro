---
// Server-rendered homepage teaser for the services directory — replaces
// the client:visible ServicesCategoriesSection.tsx, whose loading spinner
// was baked into the homepage HTML (audit finding H-1).
//
// Renders immediately with the all-bases counts (no spinner), then a
// tiny inline script re-counts against the visitor's selected base
// (localStorage `selectedBase`, updated on the `baseChanged` event that
// Header + the base modal dispatch) and updates the numbers in place.
// All nine categories always show; ones with zero for the current base
// get the muted "Coming soon" treatment.

import { supabase } from '../../services/supabaseClient';

// Icons are inline Lucide paths — one consistent stroke set, no emoji.
// Each carries a muted accent tint (stroke + faint chip fill).
const CATEGORIES = [
  { id: 'automotive', title: 'Automotive', tint: '#bd6a4e', icon: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>' },
  { id: 'healthcare', title: 'Healthcare', tint: '#b05e6d', icon: '<path d="M11 2v2M5 2v2M15 2v2M9 2v2M12 4v6a4 4 0 0 1-8 0V4M8 14v3a5 5 0 0 0 10 0v-1a3 3 0 0 0-3-3h-3"/><circle cx="20" cy="10" r="2"/>' },
  { id: 'restaurants', title: 'Restaurants & Dining', tint: '#b8802f', icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2M7 2v20M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>' },
  { id: 'shopping', title: 'Shopping & Personal Care', tint: '#7c6bb0', icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/>' },
  { id: 'home-services', title: 'Home Services', tint: '#3d8a85', icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z"/>' },
  { id: 'real-estate', title: 'Real Estate', tint: '#5e9350', icon: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/>' },
  { id: 'legal-business', title: 'Legal Services', tint: '#6a7a94', icon: '<path d="M12 3v18M7 21h10M5 7l7-4 7 4M5 7l-2 6a4 4 0 0 0 8 0L9 7M19 7l-2 6a4 4 0 0 0 8 0l-2-6"/>' },
  { id: 'education', title: 'Education', tint: '#4f7cb0', icon: '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>' },
  { id: 'hbb', title: 'Tax & Business', tint: '#a3862c', icon: '<rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>' },
];

let rows: { category: string; bases_served: string[] }[] = [];
if (supabase) {
  const { data } = await supabase
    .from('businesses')
    .select('category, bases_served')
    .eq('status', 'active');
  rows = (data ?? []).filter((r) => r.category);
}

const counts: Record<string, number> = {};
for (const r of rows) counts[r.category] = (counts[r.category] ?? 0) + 1;
const total = rows.length;

// Compact payload for the client re-count: [categoryIndex, basesBitmask?]
// — simplest is just category + bases list.
const payload = rows.map((r) => ({ c: r.category, b: r.bases_served ?? [] }));
---

<section id="english-services" class="svc">
  <div class="svc__bg" aria-hidden="true"></div>
  <div class="svc__inner">
    <div class="svc__head">
      <p class="svc__eyebrow">The directory</p>
      <h2>English-Speaking Services Near Your Base</h2>
      <p class="svc__lede">
        <span data-svc-total>{total}</span> personally checked, English-friendly businesses that understand
        U.S. military and expat families — car dealers, doctors, lawyers, tax advisors, and more.
      </p>
    </div>

    <div class="svc__grid" data-svc-grid>
      {
        CATEGORIES.map((c) => {
          const n = counts[c.id] ?? 0;
          return (
            <a
              href={`/services/${c.id}`}
              class:list={['svc-card', n === 0 && 'svc-card--empty']}
              data-cat={c.id}
            >
              <span class="svc-card__icon" aria-hidden="true" style={`--tint:${c.tint}`}>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
              </span>
              <span class="svc-card__text">
                <span class="svc-card__title">{c.title}</span>
                <span class="svc-card__count" data-count>
                  {n > 0 ? `${n} ${n === 1 ? 'business' : 'businesses'}` : 'Coming soon'}
                </span>
              </span>
            </a>
          );
        })
      }
    </div>

    <script type="application/json" data-svc-data set:html={JSON.stringify(payload)} />
    <script>
      (() => {
        const root = document.querySelector('.svc');
        if (!root) return;
        const dataEl = root.querySelector('[data-svc-data]');
        let rows: { c: string; b: string[] }[] = [];
        try {
          rows = JSON.parse(dataEl?.textContent || '[]');
        } catch {
          return;
        }
        const totalEl = root.querySelector('[data-svc-total]');
        const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-cat]'));

        function apply() {
          let base = 'all';
          try {
            base = localStorage.getItem('selectedBase') || 'all';
          } catch {}
          const counts: Record<string, number> = {};
          let total = 0;
          for (const r of rows) {
            if (base !== 'all' && !r.b.includes(base)) continue;
            counts[r.c] = (counts[r.c] || 0) + 1;
            total++;
          }
          if (totalEl) totalEl.textContent = String(total);
          for (const card of cards) {
            const n = counts[card.dataset.cat || ''] || 0;
            const countEl = card.querySelector('[data-count]');
            if (countEl) countEl.textContent = n > 0 ? `${n} ${n === 1 ? 'business' : 'businesses'}` : 'Coming soon';
            card.classList.toggle('svc-card--empty', n === 0);
          }
        }

        apply();
        window.addEventListener('baseChanged', apply);
        document.addEventListener('astro:page-load', apply);
      })();
    </script>

    <div class="svc__actions">
      <a href="/services-directory" class="svc__btn svc__btn--primary">Browse the full directory</a>
      <a href="/submit-business" class="svc__btn svc__btn--ghost">List your business</a>
    </div>
  </div>
</section>

<style>
  .svc {
    position: relative;
    padding: 5rem 0;
    overflow: hidden;
    isolation: isolate;
  }
  .svc__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(105deg, rgba(9, 58, 88, 0.9) 0%, rgba(12, 74, 110, 0.82) 100%),
      url('https://pkacbcohrygpyapgtzpq.supabase.co/storage/v1/object/public/images/services.jpg') center / cover no-repeat;
  }
  .svc__inner {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .svc__head {
    text-align: center;
    color: #fff;
    margin-bottom: 2.75rem;
  }
  .svc__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 0.75rem;
  }
  .svc__head h2 {
    font-size: clamp(1.85rem, 4vw, 2.4rem);
    font-weight: 700;
    margin: 0 0 0.85rem;
    text-wrap: balance;
  }
  .svc__lede {
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    max-width: 38rem;
    margin: 0 auto;
  }
  .svc__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 560px) {
    .svc__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .svc__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .svc-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.35rem;
    background: #fff;
    border-radius: 0.85rem;
    text-decoration: none;
    color: var(--brand-text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .svc-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px -14px rgba(0, 0, 0, 0.45);
  }
  .svc-card--empty {
    background: rgba(255, 255, 255, 0.72);
  }
  .svc-card--empty .svc-card__icon {
    background: var(--brand-bg-alt);
    color: var(--brand-text-muted);
  }
  .svc-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--tint, var(--brand-primary)) 14%, transparent);
    color: var(--tint, var(--brand-primary));
    flex-shrink: 0;
  }
  .svc-card__icon svg {
    width: 1.45rem;
    height: 1.45rem;
  }
  .svc-card__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .svc-card__title {
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
  }
  .svc-card__count {
    font-size: 0.82rem;
    color: var(--brand-text-muted);
  }
  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .svc__btn {
    display: inline-block;
    padding: 0.85rem 1.7rem;
    border-radius: 9999px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .svc__btn--primary {
    background: var(--brand-gold);
    color: var(--brand-dark);
  }
  .svc__btn--primary:hover {
    background: var(--brand-secondary-light, var(--brand-gold));
  }
  .svc__btn--ghost {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.5);
  }
  .svc__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.22);
  }
</style>
