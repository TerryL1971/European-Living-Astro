---
// Static homepage teaser for the phrasebook — replaces the full
// client:load TravelPhrasesSection that used to render here with its
// "Loading phrases…" spinner (audit finding H-1). The full interactive
// phrasebook (8 languages, search, favourites, audio) still lives at
// /travel-phrases.
//
// Pulls a few greetings at build time so the section shows real content
// with zero client JS.

import { phraseService } from '../../services/phraseService';

const LANGS = [
  { code: 'de', label: 'German' },
  { code: 'fr', label: 'French' },
  { code: 'it', label: 'Italian' },
  { code: 'es', label: 'Spanish' },
];

// A small Lucide line icon per sample phrase — same stroke set as the
// category cards, tinted with the muted palette.
const PHRASE_ICON: Record<string, { tint: string; icon: string }> = {
  Hello: {
    tint: '#3d8a85',
    icon: '<path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2"/><path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"/><path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>',
  },
  'Thank you': {
    tint: '#b05e6d',
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  },
  'Excuse me': {
    tint: '#b8802f',
    icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/>',
  },
  'Do you speak English?': {
    tint: '#4f7cb0',
    icon: '<path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>',
  },
};

let samples: { english: string; rows: { label: string; text: string }[] }[] = [];
try {
  const greetings = await phraseService.getPhrasesByCategory('greetings');
  const pick = ['Hello', 'Thank you', 'Excuse me', 'Do you speak English?'];
  samples = greetings
    .filter((p) => pick.includes(p.english))
    .sort((a, b) => pick.indexOf(a.english) - pick.indexOf(b.english))
    .map((p) => ({
      english: p.english,
      rows: LANGS.map((l) => ({ label: l.label, text: p.translations[l.code]?.text ?? '—' })).filter(
        (r) => r.text !== '—',
      ),
    }));
} catch {
  samples = [];
}
---

{
  samples.length > 0 && (
    <section class="ph">
      <div class="ph__inner">
        <div class="ph__head">
          <p class="ph__eyebrow">Phrasebook</p>
          <h2>Say it in the local language</h2>
          <p class="ph__lede">
            Greetings, directions, and ordering dinner in the eight languages you'll actually use on
            trips from your base — German, French, Italian, Spanish and more, each with pronunciation
            and audio.
          </p>
        </div>

        <div class="ph__grid">
          {samples.map((s) => (
            <div class="ph-card" style={PHRASE_ICON[s.english] ? `--tint:${PHRASE_ICON[s.english].tint}` : undefined}>
              <p class="ph-card__en">
                {PHRASE_ICON[s.english] && (
                  <span class="ph-card__icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={PHRASE_ICON[s.english].icon} />
                  </span>
                )}
                <span>{s.english}</span>
              </p>
              <ul class="ph-card__list">
                {s.rows.map((r) => (
                  <li>
                    <span class="ph-card__lang">{r.label}</span>
                    <span class="ph-card__text">{r.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="ph__cta">
          <a href="/travel-phrases">Open the full phrasebook <span aria-hidden="true">›</span></a>
        </div>
      </div>
    </section>
  )
}

<style>
  .ph {
    background: var(--brand-bg-alt);
    padding: 4rem 0;
  }
  .ph__inner {
    max-width: 62rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .ph__head {
    text-align: center;
    margin-bottom: 2.25rem;
  }
  .ph__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand-primary);
    margin: 0 0 0.75rem;
  }
  .ph__head h2 {
    font-size: clamp(1.8rem, 4vw, 2.3rem);
    font-weight: 700;
    color: var(--brand-dark);
    margin: 0 0 0.75rem;
    text-wrap: balance;
  }
  .ph__lede {
    color: var(--brand-text-muted);
    max-width: 40rem;
    margin: 0 auto;
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .ph__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .ph-card {
    background: var(--brand-bg-card);
    border: 1px solid var(--brand-border);
    border-radius: 0.85rem;
    padding: 1.1rem 1.2rem;
  }
  .ph-card__en {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    color: var(--brand-dark);
    margin: 0 0 0.6rem;
    padding-bottom: 0.55rem;
    border-bottom: 2px solid var(--tint, var(--brand-primary));
  }
  .ph-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--tint, var(--brand-primary)) 14%, transparent);
    color: var(--tint, var(--brand-primary));
    flex-shrink: 0;
  }
  .ph-card__icon svg {
    width: 1.05rem;
    height: 1.05rem;
  }
  .ph-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .ph-card__list li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.9rem;
  }
  .ph-card__lang {
    color: var(--brand-text-muted);
    flex-shrink: 0;
  }
  .ph-card__text {
    font-weight: 600;
    color: var(--brand-primary);
    text-align: right;
  }
  .ph__cta {
    text-align: center;
  }
  .ph__cta a {
    font-weight: 600;
    color: var(--brand-primary);
    text-decoration: none;
    font-size: 1rem;
  }
  .ph__cta a:hover {
    text-decoration: underline;
  }
</style>
