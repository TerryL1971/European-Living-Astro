---
// STATIC, HIGH PRIORITY SEO/AEO page — pre-rendered at build time from
// the real `articles` table, EXCLUDING City Guides (those live at
// /destinations/[slug].astro — confirmed via Search Console indexed
// pages 2026-07-11: destinations are indexed at /destinations/<slug>,
// separate from genuine articles at /articles/<slug>).
//
// PRINT/PDF SUPPORT: "Print / Save as PDF" button + ?print=true
// auto-trigger (matches /pcs-guide's "PCS Germany Checklist" resource
// link, which uses that query param). Chrome-hiding for print lives in
// BaseLayout.astro's global stylesheet, not here — Astro scopes
// component <style> blocks to their own template, so a rule here can't
// reach <body>/<Header>/<Footer>, which are rendered by BaseLayout, not
// this page.
//
// TABLE OF CONTENTS: auto-generated from the article's ##/### headings
// via extractHeadings() — sticky sidebar on desktop, collapsible
// dropdown on mobile (both in TableOfContents.astro, zero JS). Only
// rendered when there are at least 3 headings, so short articles
// (Germany 101's few sections, the car-buying guide) don't show a
// near-empty box.

import BaseLayout from '../../layouts/BaseLayout.astro';
import AnswerBox from '../../components/seo/AnswerBox.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import TableOfContents from '../../components/articles/TableOfContents.astro';
import { articleSchema } from '../../lib/seo/schema';
import { getAllArticles, renderArticleContent, extractHeadings, type ArticleRow } from '../../lib/supabaseArticles';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: ArticleRow;
}
const { article } = Astro.props as Props;

const description =
  article.excerpt ??
  `${article.title} — practical guidance for U.S. military families and expats in Germany.`;

const schema = articleSchema({
  headline: article.title,
  description,
  slug: article.slug,
  datePublished: article.created_at,
  dateModified: article.updated_at,
  image: article.featured_image_url ?? undefined,
  authorName: article.author ?? undefined,
});

// Stored article bodies frequently repeat the title (as a leading
// Markdown `# Heading`, rendered to <h1>) and the dek (as an italic
// intro line) that this page's header already renders — strip a leading
// <h1> and a leading fully-italic paragraph so there's exactly one H1
// and the dek shows once.
const contentHtml = renderArticleContent(article.content)
  .replace(/^\s*<h1\b[^>]*>[\s\S]*?<\/h1>\s*/i, '')
  .replace(/^\s*<p>\s*<em>[\s\S]*?<\/em>\s*<\/p>\s*/i, '');
const headings = extractHeadings(article.content);
const showToc = headings.length >= 3;

const lastUpdatedHuman = new Date(article.updated_at).toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});

// Matches the live site's ?print=true pattern (see /pcs-guide's
// resource link to /articles/pcs-germany-checklist?print=true) — jump
// straight to the browser's print dialog instead of landing on the
// plain page first.
const shouldAutoPrint = Astro.url.searchParams.get('print') === 'true';
---

<BaseLayout
  title={article.title}
  description={description}
  canonicalPath={`/articles/${article.slug}`}
  ogImage={article.featured_image_url ?? undefined}
  pageSchemas={[schema]}
>
  <article class="article-page">
    <div class="article-page__header">
      <Breadcrumbs
        items={[
          { name: 'Articles', url: '/articles' },
          { name: article.title, url: `/articles/${article.slug}` },
        ]}
      />

      <h1>{article.title}</h1>
      {article.subtitle && <p class="article__subtitle">{article.subtitle}</p>}

      <Byline updated={article.updated_at} />

      <button type="button" class="article__print-btn" data-print-trigger>
        🖨 Print / Save as PDF
      </button>
    </div>

    <div class="article-layout">
      <div class="article-main">
        {article.excerpt && <AnswerBox answer={article.excerpt} lastUpdated={lastUpdatedHuman} />}
        <div class="prose article__body" set:html={contentHtml} />
      </div>

      {showToc && (
        <div class="article-toc-slot">
          <TableOfContents headings={headings} />
        </div>
      )}
    </div>

    <!--
      No FAQ schema here: the real `articles` table has no dedicated FAQ
      column/relation, so we don't fabricate FAQPage markup that wouldn't
      match visible content. If Q&A-style content gets added later, wire
      FaqBlock.astro back in against that.
    -->
  </article>
</BaseLayout>

<script>
  // Wrapped in astro:page-load — see BaseLayout.astro's <ClientRouter />
  // comment: this is a dynamic route, but revisiting the SAME article a
  // second time in one session still needs this, since the button
  // elements it queries get replaced on every visit. Wires up every
  // [data-print-trigger] button on the page — currently just the one,
  // but works if a second button is ever added (the live site has one
  // near the top and one at the bottom).
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-print-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => window.print());
    });
  });
</script>

{shouldAutoPrint && (
  <script>
    // ?print=true — jump straight to the print dialog once the page has
    // rendered, matching the live site's link-with-query-param pattern.
    // astro:page-load instead of window's 'load' event: 'load' only
    // fires on a true hard navigation, not a <ClientRouter /> transition
    // — someone clicking a ...?print=true link while already browsing
    // the site (e.g. the PCS Guide's checklist link) would otherwise
    // never trigger the print dialog at all.
    document.addEventListener('astro:page-load', () => window.print());
  </script>
)}

<style>
  .article-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .article-page__header {
    max-width: 42rem;
  }
  .article-page__header h1 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.25rem;
  }
  .article__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .article__print-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    margin: 0.5rem 0 1.5rem;
    background: var(--brand-primary, #0284c7);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .article__print-btn:hover {
    background: var(--brand-primary-dark, #0c4a6e);
  }

  /* Layout: single column (ToC dropdown above content) on mobile,
     content + sticky sidebar on desktop. */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .article-main {
    min-width: 0; /* prevents grid blowout from long unbroken strings/URLs */
  }
  .article-toc-slot {
    order: -1; /* mobile: dropdown above the article body */
  }
  @media (min-width: 900px) {
    .article-layout {
      grid-template-columns: minmax(0, 42rem) 260px;
      gap: 2rem;
      align-items: start;
    }
    .article-toc-slot {
      order: 0; /* desktop: natural order, sidebar sits to the right */
    }
  }

  /* ── Print stylesheet ──────────────────────────────────────────── */
  /* Chrome-hiding (header/nav/footer) lives in BaseLayout.astro's
     global stylesheet, not here — see the comment there for why a
     scoped rule in this file can't reach <body>/<Header>/<Footer>. */
  @media print {
    .article__print-btn {
      display: none !important;
    }

    .article-page {
      max-width: 100%;
      padding: 0;
    }
    .article-layout {
      display: block;
    }

    .article-page__header h1 {
      font-size: 22pt;
    }

    .prose h2 {
      font-size: 15pt;
      margin-top: 1.5em;
      page-break-after: avoid;
    }
    .prose h3 {
      font-size: 12pt;
      page-break-after: avoid;
    }
    .prose ul,
    .prose ol {
      page-break-inside: avoid;
    }
    .prose table {
      page-break-inside: avoid;
    }

    /* Print the actual destination URL after external links, since a
       clickable link is useless on paper — matches how most print
       stylesheets handle this. */
    .prose a[href^="http"]::after {
      content: ' (' attr(href) ')';
      font-size: 0.8em;
      color: #555;
    }
  }
</style>