---
// Per-category listing — matches the URLs ServicesCategoriesSection.tsx
// already generates (`/services/${category.id}?base=${selectedBase}`).
// Statically generated for all 9 known categories regardless of
// current business count, so a category with zero businesses today
// still gets a real page (matching the "Coming Soon" treatment
// ServicesCategoriesSection shows on the homepage) rather than 404ing.

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import BusinessListCard from '../../components/BusinessListCard.astro';
import { fetchBusinessesByCategory } from '../../services/businessServices';
import { serviceCategories } from '../../data/serviceCategories';
// Use the real base list (id + name) — the base-filter <option> values
// MUST equal the ids stored in businesses.bases_served, or the filter
// silently matches nothing. (siteConfig.BASES is display strings like
// "Ramstein / KMC" — using those was the bug.)
import { BASES } from '../../data/bases';
import type { ServiceCategory } from '../../types/business';

export async function getStaticPaths() {
  return serviceCategories.map((cat) => ({
    params: { category: cat.id },
    props: { categoryId: cat.id },
  }));
}

interface Props {
  categoryId: string;
}
const { categoryId } = Astro.props as Props;

const categoryDef = serviceCategories.find((c) => c.id === categoryId);
const businesses = await fetchBusinessesByCategory(categoryId as ServiceCategory);
const sortedBusinesses = [...businesses].sort((a, b) => {
  if (a.featured !== b.featured) return a.featured ? -1 : 1;
  return a.name.localeCompare(b.name);
});
---

<BaseLayout
  title={categoryDef?.title ?? categoryId}
  description={categoryDef?.description ?? `English-speaking ${categoryId} businesses serving U.S. military families in Germany.`}
  canonicalPath={`/services/${categoryId}`}
>
  <div class="category-listing">
    <Breadcrumbs items={[{ name: 'Services Directory', url: '/services-directory' }, { name: categoryDef?.title ?? categoryId, url: `/services/${categoryId}` }]} />

    <h1>{categoryDef?.title ?? categoryId}</h1>
    {categoryDef?.description && <p class="category-listing__lede">{categoryDef.description}</p>}
    <p class="category-listing__count">
      <span data-count>{sortedBusinesses.length}</span>{' '}<span data-count-noun>{sortedBusinesses.length === 1 ? 'business' : 'businesses'}</span>
    </p>

    {sortedBusinesses.length > 0 && (
      <div class="category-listing__filters">
        <select id="category-base-filter" class="category-listing__select" aria-label="Filter by base">
          <option value="">All bases</option>
          {BASES.map((base) => <option value={base.id}>{base.name}</option>)}
        </select>
      </div>
    )}

    <div class="category-listing__grid" id="category-grid">
      {sortedBusinesses.map((business) => <BusinessListCard business={business} />)}
    </div>

    <div class="category-listing__empty" id="category-empty" hidden={sortedBusinesses.length > 0}>
      <p data-empty-msg>No businesses in this category yet.</p>
      <a href="/submit-business">List your business</a>
    </div>
  </div>
</BaseLayout>

<script>
  // Wrapped in astro:page-load — see BaseLayout.astro's <ClientRouter />
  // comment. This is a dynamic route (one script per category), so
  // each category page's script is a distinct module — but revisiting
  // the SAME category a second time in one session still needs this,
  // since the DOM elements it queries get replaced on every visit.
  document.addEventListener('astro:page-load', () => {
    const baseSelect = document.getElementById('category-base-filter') as HTMLSelectElement | null;
    const grid = document.getElementById('category-grid');
    const countEl = document.querySelector<HTMLElement>('.category-listing__count [data-count]');
    const nounEl = document.querySelector<HTMLElement>('.category-listing__count [data-count-noun]');
    const emptyEl = document.getElementById('category-empty');
    const emptyMsg = emptyEl?.querySelector<HTMLElement>('[data-empty-msg]');

    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.business-card'));
    const totalCards = cards.length;

    function applyBaseFilter() {
      const base = baseSelect?.value ?? '';
      let shown = 0;
      cards.forEach((card) => {
        // card.dataset.bases is the comma-joined list of base ids the
        // business serves — must match the <option> values (base.id).
        const served = (card.dataset.bases ?? '').split(',').filter(Boolean);
        const matches = !base || served.includes(base);
        card.hidden = !matches;
        if (matches) shown += 1;
      });
      if (countEl) countEl.textContent = String(shown);
      if (nounEl) nounEl.textContent = shown === 1 ? 'business' : 'businesses';
      if (emptyEl) {
        emptyEl.hidden = totalCards === 0 ? false : shown > 0;
        if (emptyMsg && totalCards > 0) {
          emptyMsg.textContent = base
            ? 'No businesses here serve that base yet.'
            : 'No businesses in this category yet.';
        }
      }
    }

    baseSelect?.addEventListener('change', applyBaseFilter);

    // Pre-select the base filter from ?base= if present, otherwise fall
    // back to the visitor's stored base — so links from the homepage
    // teaser (which are static and carry no query param) still land
    // filtered to the base the visitor picked.
    const params = new URLSearchParams(window.location.search);
    let initialBase = params.get('base');
    if (!initialBase) {
      try {
        const stored = localStorage.getItem('selectedBase');
        if (stored && stored !== 'all') initialBase = stored;
      } catch {}
    }
    if (initialBase && baseSelect) {
      const match = Array.from(baseSelect.options).some((o) => o.value === initialBase);
      if (match) baseSelect.value = initialBase;
    }
    applyBaseFilter();
  });
</script>

<style>
  .category-listing {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 4rem;
  }
  .category-listing h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .category-listing__lede {
    color: var(--brand-text-muted);
    max-width: 42rem;
  }
  .category-listing__count {
    font-size: 0.875rem;
    color: var(--brand-text-muted);
    margin: 0.5rem 0 1.5rem;
  }
  .category-listing__filters {
    margin-bottom: 1.5rem;
  }
  .category-listing__select {
    border: 1px solid var(--brand-border);
    border-radius: 0.5rem;
    padding: 0.625rem 1rem;
    background: white;
  }
  .category-listing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.25rem;
  }
  .category-listing__empty {
    text-align: center;
    padding: 3rem 0;
    color: var(--brand-text-muted);
  }
  .category-listing__empty a {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--brand-blue);
    font-weight: 600;
  }
</style>
