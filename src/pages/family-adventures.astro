interface CountryHighlight {
  name: string;
  type: string;
  description: string;
  ages: AgeGroup;
  link: string | null;
}

interface CountryData {
  code: 'uk' | 'italy' | 'spain';
  emoji: string;
  title: string;
  subtitle: string;
  highlights: CountryHighlight[];
}

