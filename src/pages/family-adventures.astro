---
// STATIC page — fully static HTML for SEO (every card/link is real
// markup, nothing hidden from crawlers at build time). The age filter
// and country tabs are pure client-side show/hide over pre-rendered
// content, same pattern as the day-trips base filter and the
// destinations carousel — no React island needed for any of this.
//
// Ported from FamilyAdventuresPage.tsx. All data is static/editorial
// content (not from Supabase), so it lives directly in this file's
// frontmatter as plain data, same as the original component's
// hardcoded arrays.

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';

