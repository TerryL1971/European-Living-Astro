const AGE_LABELS: Record<AgeGroup, string> = {
  all: 'All Ages',
  toddler: 'Toddlers (0-4)',
  school: 'School Age (5-12)',
  teen: 'Teens (13+)',
};
---

<BaseLayout
  title="Family Adventures in Europe"
  description="Family-friendly destinations, activities, schools, and services near US military bases in Germany. Plus travel highlights for UK, Italy, and Spain."
  canonicalPath="/family-adventures"
>
  <div class="fa-hero">
    <div class="fa-hero__inner">
      <div class="fa-hero__emoji">🧭</div>
      <h1>Family Adventures in Europe</h1>
      <p>
        Europe is an incredible playground for kids of all ages. Find
        family-friendly activities near your base — and unforgettable
        highlights when you travel across Europe.
      </p>
    </div>
  </div>

  <div class="fa-container">
    <Breadcrumbs items={[{ name: 'Family Adventures', url: '/family-adventures' }]} />

    <div class="fa-age-filter">
      <p class="fa-age-filter__label">Filter by age group:</p>
      {(Object.keys(AGE_LABELS) as AgeGroup[]).map((age) => (
        <button type="button" class="fa-age-btn" data-age={age} data-active={age === 'all' ? 'true' : 'false'}>
          {AGE_LABELS[age]}
        </button>
      ))}
    </div>

    <div class="fa-section">
      <div class="fa-section__header">
        <span class="fa-section__flag">🇩🇪</span>
        <div>
          <h2>Germany — Near Your Base</h2>
          <p>Base-specific family resources and activities</p>
        </div>
      </div>

      {GERMANY_RESOURCES.map((baseGroup) => (
        <div class="fa-base-block" data-base={baseGroup.base}>
          <div class="fa-base-block__header">
            <span>{baseGroup.emoji}</span>
            <h3>{baseGroup.base}</h3>
          </div>
          <div class="fa-card-grid">
            {baseGroup.items.map((item) => (
              <div class="fa-card" data-ages={item.ages}>
                <div class="fa-card__top">
                  <span class="fa-card__type">{item.type}</span>
                  <span class="fa-card__age">{AGE_LABELS[item.ages]}</span>
                </div>
                <h4>{item.name}</h4>
                <p>{item.description}</p>
                {item.link && (
                  <a href={item.link} target="_blank" rel="noopener noreferrer" class="fa-card__link">
                    Visit Website →
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="fa-section">
      <div class="fa-section__header fa-section__header--centered">
        <h2>🌍 Travel Highlights Across Europe</h2>
        <p>Must-see family experiences when you venture beyond Germany</p>
      </div>

      <div class="fa-country-tabs">
        {COUNTRY_HIGHLIGHTS.map((country, i) => (
          <button type="button" class="fa-country-tab" data-country={country.code} data-active={i === 0 ? 'true' : 'false'}>
            {country.emoji} {country.title}
          </button>
        ))}
      </div>

      {COUNTRY_HIGHLIGHTS.map((country, i) => (
        <div class="fa-country-panel" data-country-panel={country.code} hidden={i !== 0}>
          <p class="fa-country-panel__subtitle">{country.subtitle}</p>
          <div class="fa-card-grid">
            {country.highlights.map((item) => (
              <div class="fa-card" data-ages={item.ages}>
                <div class="fa-card__top">
                  <span class="fa-card__type">{item.type}</span>
                  <span class="fa-card__age">{AGE_LABELS[item.ages]}</span>
                </div>
                <h4>{item.name}</h4>
                <p>{item.description}</p>
                {item.link && (
                  <a href={item.link} target="_blank" rel="noopener noreferrer" class="fa-card__link">
                    Visit Website →
                  </a>
                )}
              </div>
            ))}
          </div>
          <p class="fa-country-panel__empty" hidden>
            No highlights for this age group in {country.title} yet.
            <br />
            <button type="button" class="fa-show-all-ages">Show all ages →</button>
          </p>
        </div>
      ))}
    </div>

    <div class="fa-cta">
      <div class="fa-cta__emoji">🙌</div>
      <h3>Know a great family resource we missed?</h3>
      <p>
        We're always adding to this guide. Share your family's favorite spot near base
        and we'll add it to the list.
      </p>
      <a href="/submit-business" class="fa-cta__button">Submit a Family Resource</a>
    </div>
  </div>
</BaseLayout>

<style>
  .fa-hero {
    background: linear-gradient(to right, #f97316, #eab308);
    padding: 4rem 1.5rem;
  }
  .fa-hero__inner {
    max-width: 56rem;
    margin: 0 auto;
    text-align: center;
    color: white;
  }
  .fa-hero__emoji {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .fa-hero__inner h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .fa-hero__inner h1 {
      font-size: 3rem;
    }
  }
  .fa-hero__inner p {
    font-size: 1.125rem;
    opacity: 0.9;
    max-width: 42rem;
    margin: 0 auto;
