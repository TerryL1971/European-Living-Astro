---
import BaseLayout from '../layouts/BaseLayout.astro';
import FamilyAdventuresExplorer from '../components/FamilyAdventuresExplorer';
---
<BaseLayout
  title="Family Adventures in Europe"
  description="Family-friendly destinations, activities, schools, and services near US military bases in Germany. Plus travel highlights for UK, Italy, and Spain."
  canonicalPath="/family-adventures"
>
  <div class="min-h-screen bg-[var(--brand-bg)]">

    <!-- Hero Banner -->
    <div class="bg-gradient-to-r from-orange-500 to-yellow-500 py-16 px-6">
      <div class="max-w-4xl mx-auto text-center text-white">
        <div class="text-5xl mb-4">🧭</div>
        <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Family Adventures in Europe</h1>
        <p class="text-lg md:text-xl opacity-90 max-w-2xl mx-auto">
          Europe is an incredible playground for kids of all ages. Find family-friendly
          activities near your base — and unforgettable highlights when you travel across
          Europe.
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 py-12">
      <FamilyAdventuresExplorer client:load />

      <!-- Submit a Resource CTA -->
      <div class="mt-16 bg-orange-50 border-2 border-orange-200 rounded-2xl p-8 text-center">
        <div class="text-4xl mb-3">🙌</div>
        <h3 class="text-xl font-bold text-[var(--brand-dark)] mb-2">
          Know a great family resource we missed?
        </h3>
        <p class="text-[var(--muted-foreground)] mb-5">
          We're always adding to this guide. Share your family's favorite spot near base and
          we'll add it to the list.
        </p>
        <a
          href="/submit-business"
          class="inline-block px-6 py-3 bg-orange-500 hover:bg-orange-600 text-white font-bold rounded-xl transition-all"
        >
          Submit a Family Resource
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
