---
// Standalone /contact page. Wraps the existing ContactSection island
// (already ported, used on the homepage at #contact previously) with
// dedicated SEO metadata.
//
// NOTE: an earlier version of this page had a static NAP (Name/Address/
// Phone) block here for E-E-A-T SEO trust signals. Removed at Terry's
// request — it displayed his actual home address and personal phone
// number, which he doesn't want publicly listed (people showing up
// uninvited). The Impressum still legally covers the required business
// disclosure without putting it front-and-center on a public page. The
// email address stays — it's not sensitive the same way, and
// ContactSection.tsx below already surfaces it via its own button, so a
// separate NAP block would've been redundant even before the
// address/phone were removed.
//
// Ported from ContactPage.tsx. That original imported BreadcrumbSchema
// from a custom SEO.tsx component; Breadcrumbs.astro (used on every
// other page) was intentionally left off this one at Terry's request —
// he didn't want "Home / Contact" clutter on this specific page, even
// though it's the standard pattern elsewhere (articles/[slug].astro,
// day-trips/[slug].astro, etc.).

import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/page/ContactSection.tsx';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with European Living — your resource for US military families and American expats living in Germany. Email, WhatsApp, or send us a message."
  canonicalPath="/contact"
>
  <ContactSection client:load />
</BaseLayout>