---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DayTripsExplorer from '../../components/DayTripsExplorer';
import { getAllDayTrips } from '../../lib/supabaseDayTrips';

const dayTrips = await getAllDayTrips();
---
<BaseLayout
  title="Day Trips from US Military Bases in Germany"
  description="Discover amazing day trips from US military bases in Germany. Find castles, cities, nature, and cultural experiences within easy reach."
  canonicalPath="/day-trips"
>
  <div
    class="relative overflow-hidden text-[var(--brand-white)] flex items-end aspect-[4.3/1] min-h-[300px] max-h-[460px]"
    style="background-image:url('https://pkacbcohrygpyapgtzpq.supabase.co/storage/v1/object/public/images/Day-Trips-&-Weekend-Getaways.jpeg');background-size:cover;background-position:center 35%;"
  >
    <div
      class="absolute inset-0 pointer-events-none"
      style="background:linear-gradient(90deg, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.1) 100%);"
    ></div>
    <div
      class="absolute inset-0 pointer-events-none"
      style="background:linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.55) 100%);"
    ></div>
    <div class="relative max-w-7xl mx-auto px-6 py-10 w-full">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">🗺️ Day Trips &amp; Weekend Getaways</h1>
      <p class="text-xl max-w-3xl">
        Explore incredible destinations within a few hours of your base. From medieval castles to
        vibrant cities, discover the best of Europe on a day trip.
      </p>
    </div>
  </div>

  <DayTripsExplorer trips={dayTrips} client:load />
</BaseLayout>
