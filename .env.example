# Copy to .env and fill in. Astro requires the PUBLIC_ prefix (not VITE_)
# for any variable exposed to the client bundle.

# Supabase — used at build time (Node) and runtime (browser)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# GA4 — gated behind cookie consent; analytics is a no-op if unset or in dev
PUBLIC_GA4_ID=

# Sentry — gated behind cookie consent; error monitoring is a no-op if unset
PUBLIC_SENTRY_DSN=

# Supabase CLI — only needed to run migrations locally (supabase db push)
SUPABASE_ACCESS_TOKEN=
